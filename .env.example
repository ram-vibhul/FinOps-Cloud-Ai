# Copy to .env and fill in. Never commit .env.
# Deployment mode: local | saas | self_hosted
CCRADAR_DEPLOYMENT_MODE=self_hosted
CCRADAR_BASE_URL=https://ccradar.example.com
CCRADAR_ENVIRONMENT_NAME=production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CCRADAR_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CCRADAR_ENCRYPTION_KEYS=
# Database owner (migrations only) and the app's runtime role (row-level security applies).
POSTGRES_PASSWORD=
CCRADAR_DB_APP_PASSWORD=
# Sign in with Google: Google Cloud console > APIs & Services > Credentials >
# OAuth client ID (Web application). Authorised redirect URI:
#   <CCRADAR_BASE_URL>/api/v1/auth/callback/google
CCRADAR_GOOGLE_CLIENT_ID=
CCRADAR_GOOGLE_CLIENT_SECRET=
# Optional: only these email domains may sign in (JSON list)
# CCRADAR_ALLOWED_EMAIL_DOMAINS=["example.com"]
# AWS: the IAM principal customers trust in their read-only CloudCostRadar role (the role or
# user this installation runs as; its credentials come from the normal AWS chain).
# CCRADAR_AWS_PRINCIPAL_ARN=arn:aws:iam::123456789012:role/ccradar-collector
# Exchange rates: ecb (free daily ECB reference rates) or none (offline installs)
# CCRADAR_FX_PROVIDER=ecb
# Optional AI summaries
# CCRADAR_ANTHROPIC_API_KEY=
# CCRADAR_AI_MODEL=claude-opus-5-5
