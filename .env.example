# Copy to .env and fill in. Never commit .env.
# Deployment mode: local | saas | self_hosted
COSTLENS_DEPLOYMENT_MODE=self_hosted
COSTLENS_BASE_URL=https://costlens.example.com
COSTLENS_ENVIRONMENT_NAME=production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
COSTLENS_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COSTLENS_ENCRYPTION_KEYS=
# Database owner (migrations only) and the app's runtime role (row-level security applies).
POSTGRES_PASSWORD=
COSTLENS_DB_APP_PASSWORD=
# Sign in with Google: Google Cloud console > APIs & Services > Credentials >
# OAuth client ID (Web application). Authorised redirect URI:
#   <COSTLENS_BASE_URL>/api/v1/auth/callback/google
COSTLENS_GOOGLE_CLIENT_ID=
COSTLENS_GOOGLE_CLIENT_SECRET=
# Optional: only these email domains may sign in (JSON list)
# COSTLENS_ALLOWED_EMAIL_DOMAINS=["example.com"]
# AWS: the IAM principal customers trust in their read-only CostLens role (the role or
# user this installation runs as; its credentials come from the normal AWS chain).
# COSTLENS_AWS_PRINCIPAL_ARN=arn:aws:iam::123456789012:role/costlens-collector
# Exchange rates: ecb (free daily ECB reference rates) or none (offline installs)
# COSTLENS_FX_PROVIDER=ecb
# Optional AI summaries
# COSTLENS_ANTHROPIC_API_KEY=
# COSTLENS_AI_MODEL=claude-opus-5-5
