# Copy to costlens.env (kept out of git) and fill in. See docs/configuration.md.
COSTLENS_DEPLOYMENT_MODE=self_hosted
COSTLENS_BASE_URL=https://costlens.example.com
COSTLENS_ENVIRONMENT_NAME=production
COSTLENS_SECRET_KEY=
COSTLENS_ENCRYPTION_KEYS=
# Runtime role (row-level security applies) and owner role (migrations only).
COSTLENS_DATABASE_URL=postgresql://costlens_app:PASSWORD@postgres.example.internal:5432/costlens
COSTLENS_MIGRATION_DATABASE_URL=postgresql://costlens:PASSWORD@postgres.example.internal:5432/costlens
COSTLENS_GOOGLE_CLIENT_ID=
COSTLENS_GOOGLE_CLIENT_SECRET=
COSTLENS_SMTP_HOST=
COSTLENS_EMAIL_FROM=CostLens <costlens@example.com>
