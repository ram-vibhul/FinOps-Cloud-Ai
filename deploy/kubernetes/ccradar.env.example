# Copy to ccradar.env (kept out of git) and fill in. See docs/configuration.md.
CCRADAR_DEPLOYMENT_MODE=self_hosted
CCRADAR_BASE_URL=https://ccradar.example.com
CCRADAR_ENVIRONMENT_NAME=production
CCRADAR_SECRET_KEY=
CCRADAR_ENCRYPTION_KEYS=
# Runtime role (row-level security applies) and owner role (migrations only).
CCRADAR_DATABASE_URL=postgresql://ccradar_app:PASSWORD@postgres.example.internal:5432/ccradar
CCRADAR_MIGRATION_DATABASE_URL=postgresql://ccradar:PASSWORD@postgres.example.internal:5432/ccradar
CCRADAR_GOOGLE_CLIENT_ID=
CCRADAR_GOOGLE_CLIENT_SECRET=
CCRADAR_SMTP_HOST=
CCRADAR_EMAIL_FROM=CloudCostRadar <ccradar@example.com>
