{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "make",
      "runtimeArgs": [
        "dev-api"
      ],
      "port": 8000
    },
    {
      "name": "ui",
      "runtimeExecutable": "make",
      "runtimeArgs": [
        "dev-ui"
      ],
      "port": 5173
    },
    {
      "name": "website",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4180",
        "--bind",
        "127.0.0.1",
        "--directory",
        "website"
      ],
      "port": 4180
    }
  ]
}
